{
    // Cloudflare Worker: liefert die gebaute Angular-Seite aus und nimmt das Kontaktformular unter /api/contact an
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "portfolio",
    "main": "worker/index.ts",
    "compatibility_date": "2026-11-01",
    // Eigene Domain: Cloudflare legt DNS-Eintrag und SSL-Zertifikat für beide Adressen selbst an
    "routes": [
        { "pattern": "keanucentamore.de", "custom_domain": true },
        { "pattern": "www.keanucentamore.de", "custom_domain": true }
    ],
    "assets": {
        "directory": "./dist/portfolio/browser",
        "binding": "ASSETS",
        // Unbekannte Pfade wie /legal-notice liefern index.html, den Rest erledigt der Angular-Router
        "not_found_handling": "single-page-application",
        // Nur /api/* geht zuerst an den Worker, alles andere kommt direkt aus den Dateien
        "run_worker_first": ["/api/*"]
    },
    // Empfänger der Kontaktformular-Nachrichten (die Adresse steht ohnehin öffentlich auf der Seite)
    "vars": {
        "CONTACT_TO": "hello@keanucentamore.de"
    }
    // Der Versand läuft über Resend. Der API-Schlüssel steht nicht im Repo, sondern als Secret:
    // npx wrangler secret put RESEND_API_KEY
}
